{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8000/index.html",
        "http://localhost:8000/persona.html?id=11",
        "http://localhost:8000/persona.html?id=12",
        "http://localhost:8000/persona.html?id=36",
        "http://localhost:8000/persona.html?id=19",
        "http://localhost:8000/persona.html?id=33"
      ],
      "numberOfRuns": 1,
      "settings": {
        "emulatedFormFactor": "mobile",
        "onlyCategories": ["accessibility", "performance", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
